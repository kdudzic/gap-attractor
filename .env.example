# Copy to .env (ignored by git) and fill in. Use it with:  uv run --env-file .env gap-attractor ...
# Nothing here is needed for the offline quick start (provider=mock wikipedia=fixture).

# --- API keys: only the provider you use ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Wikipedia dump (docs/reproduce.md, step 2). Replace 20260901 with the date of your dump. ---
GAP_ATTRACTOR_DUMP=data/wikipedia/enwiki-20260901
GAP_ATTRACTOR_DUMP_XML=enwiki-20260901-pages-articles-multistream.xml.bz2
GAP_ATTRACTOR_DUMP_INDEX=enwiki-20260901-pages-articles-multistream-index.txt.bz2

# --- Built once from the dump (docs/reproduce.md, steps 3 and 6) ---
GAP_ATTRACTOR_CACHE=data/cache
GAP_ATTRACTOR_SEARCH_INDEX=data/wikipedia/search/enwiki-20260901-titles.sqlite
GAP_ATTRACTOR_RESOURCES=data/cache/resources
GAP_ATTRACTOR_GRAPH=data/graph

# --- Where runs are written ---
GAP_ATTRACTOR_OUTPUT=runs
